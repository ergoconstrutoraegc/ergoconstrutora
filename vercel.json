{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "//": "O site publicável fica em site/ (gerado por tools/build.js). Sem esta linha a Vercel serve a raiz do repositório e a home dá 404.",
  "outputDirectory": "site",

  "//2": "Headers portados de site/.htaccess, que só vale para Apache (Hostinger/cPanel) e é ignorado pela Vercel. HTTPS e compressão a Vercel já faz sozinha.",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/favicon/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "//": "css/js não têm hash no nome — cache curto para não travar atualização",
      "source": "/assets/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    }
  ]
}
